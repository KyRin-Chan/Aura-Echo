{
  "gain": {
    "name": "Simple Gain",
    "description": "Basic volume adjustment",
    "provider": "Simple",
    "parameters": {
      "gain": {
        "name": "Gain",
        "type": "slider",
        "defaultValue": 0,
        "min": -20,
        "max": 20,
        "step": 0.1,
        "unit": "dB",
        "description": "Amount of volume boost or cut"
      }
    }
  },
  "lowpass": {
    "name": "Simple Low Pass",
    "description": "Basic IIR low-pass filter",
    "provider": "Simple",
    "parameters": {
      "cutoff": {
        "name": "Cutoff Frequency",
        "type": "slider",
        "defaultValue": 1000,
        "min": 20,
        "max": 20000,
        "step": 10,
        "unit": "Hz",
        "description": "Frequency above which signals are filtered out"
      }
    }
  },
  "highpass": {
    "name": "Simple High Pass",
    "description": "Basic IIR high-pass filter",
    "provider": "Simple",
    "parameters": {
      "cutoff": {
        "name": "Cutoff Frequency",
        "type": "slider",
        "defaultValue": 100,
        "min": 20,
        "max": 20000,
        "step": 10,
        "unit": "Hz",
        "description": "Frequency below which signals are filtered out"
      }
    }
  },
  "delay": {
    "name": "Simple Delay",
    "description": "Basic delay effect",
    "provider": "Simple",
    "parameters": {
      "delayTime": {
        "name": "Delay Time",
        "type": "slider",
        "defaultValue": 300,
        "min": 1,
        "max": 2000,
        "step": 1,
        "unit": "ms",
        "description": "Time delay for echoes"
      },
      "feedback": {
        "name": "Feedback",
        "type": "slider",
        "defaultValue": 0.3,
        "min": 0,
        "max": 0.9,
        "step": 0.01,
        "description": "Amount of feedback for multiple echoes"
      },
      "wetLevel": {
        "name": "Wet Level",
        "type": "slider",
        "defaultValue": 0.3,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "description": "Level of delayed signal"
      }
    }
  },
  "exciter": {
    "name": "Harmonic Exciter",
    "description": "Adds brightness and high-end air by synthesizing new harmonics",
    "provider": "Simple",
    "parameters": {
      "frequency": {
        "name": "Cutoff Frequency",
        "type": "slider",
        "defaultValue": 3000,
        "min": 1000,
        "max": 8000,
        "step": 100,
        "unit": "Hz",
        "description": "Frequency above which harmonics are generated"
      },
      "drive": {
        "name": "Harmonic Drive",
        "type": "slider",
        "defaultValue": 1.5,
        "min": 1.0,
        "max": 5.0,
        "step": 0.1,
        "description": "Intensity of the generated harmonics"
      },
      "mix": {
        "name": "Harmonics Mix",
        "type": "slider",
        "defaultValue": 0.15,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "description": "Volume level of the added harmonics"
      }
    }
  },
  "deesser": {
    "name": "De-esser",
    "description": "Attenuates harsh sibilant 'S' and 'T' sounds to reduce glitches",
    "provider": "Simple",
    "parameters": {
      "cutoff": {
        "name": "Crossover Frequency",
        "type": "slider",
        "defaultValue": 5000,
        "min": 3000,
        "max": 8000,
        "step": 100,
        "unit": "Hz",
        "description": "Frequency threshold for sibilance detection"
      },
      "threshold": {
        "name": "Threshold",
        "type": "slider",
        "defaultValue": -30,
        "min": -60,
        "max": -10,
        "step": 1,
        "unit": "dB",
        "description": "Level above which high-frequency compression starts"
      },
      "ratio": {
        "name": "Ratio",
        "type": "slider",
        "defaultValue": 4.0,
        "min": 1.5,
        "max": 10.0,
        "step": 0.1,
        "description": "Compression ratio for sibilance"
      }
    }
  },
  "resonanceSuppressor": {
    "name": "Dynamic Resonance Suppressor",
    "description": "Detects and suppresses sharp metallic whistles and resonances",
    "provider": "Simple",
    "parameters": {
      "threshold": {
        "name": "Sensitivity",
        "type": "slider",
        "defaultValue": 6.0,
        "min": 2.0,
        "max": 15.0,
        "step": 0.5,
        "description": "Higher values mean less sensitive, suppressing only very sharp peaks"
      },
      "amount": {
        "name": "Reduction Amount",
        "type": "slider",
        "defaultValue": 0.6,
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "description": "How aggressively to suppress detected resonance peaks"
      },
      "frequencyRange": {
        "name": "Frequency Range",
        "type": "select",
        "defaultValue": "mid-high",
        "options": ["all", "mid-high", "high"],
        "description": "Limit resonance suppression to specific frequency bands"
      }
    }
  },
  "noiseExpander": {
    "name": "Noise Expander",
    "description": "Smoothly reduces gain for signals below threshold for natural noise reduction",
    "provider": "Simple",
    "parameters": {
      "threshold": {
        "name": "Threshold",
        "type": "slider",
        "defaultValue": -35,
        "min": -60,
        "max": 0,
        "step": 1,
        "unit": "dB",
        "description": "Level below which expansion starts"
      },
      "ratio": {
        "name": "Ratio",
        "type": "slider",
        "defaultValue": 2.0,
        "min": 1.0,
        "max": 8.0,
        "step": 0.1,
        "description": "Expansion ratio (higher = steeper volume reduction)"
      },
      "attack": {
        "name": "Attack",
        "type": "slider",
        "defaultValue": 5,
        "min": 0.1,
        "max": 100,
        "step": 0.1,
        "unit": "ms",
        "description": "How quickly the expander opens (restores volume) when speech starts"
      },
      "release": {
        "name": "Release",
        "type": "slider",
        "defaultValue": 150,
        "min": 10,
        "max": 1000,
        "step": 5,
        "unit": "ms",
        "description": "How quickly the expander fades out background noise"
      }
    }
  },
  "autoTune": {
    "name": "Chromatic Auto-Tune",
    "description": "Snaps pitch to chromatic semitones and caps high notes to prevent RVC glitches",
    "provider": "Simple",
    "parameters": {
      "pitchCeiling": {
        "name": "Pitch Ceiling",
        "type": "select",
        "defaultValue": "Off",
        "options": [
          "Off",
          "G4",
          "G#4",
          "A4",
          "A#4",
          "B4",
          "C5",
          "C#5",
          "D5",
          "D#5",
          "E5",
          "F5",
          "F#5",
          "G5",
          "A5",
          "C6"
        ],
        "description": "Maximum pitch note allowed to prevent RVC high-frequency blind-zone glitches"
      },
      "retuneSpeed": {
        "name": "Retune Speed",
        "type": "slider",
        "defaultValue": 35,
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "ms",
        "description": "Auto-tune response time. 20ms-50ms is recommended for natural speech."
      }
    }
  }
}